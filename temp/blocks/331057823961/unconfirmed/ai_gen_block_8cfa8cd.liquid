{% doc %}
  @prompt
    Create a new Influencers list section for the currently previewed product page, styled as a collection-like grid of cards. Populate it dynamically from the store's Influencers metaobject entries, showing each entry's available title/name, image, and other suitable public fields, without hard-coded entry text. Prefer displaying all active entries automatically so new entries appear too. Keep it responsive and editable in the theme editor, and do not replace the existing collection list section unless the merchant chooses to remove it.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-influencers-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-inline: auto;
    padding: 32px 20px;
    color: #121212;
  }

  .ai-influencers-{{ ai_gen_id }}__heading {
    margin: 0 0 24px;
    color: #121212;
    font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.2;
    text-align: {{ block.settings.heading_alignment }};
  }

  .ai-influencers-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: 20px;
  }

  .ai-influencers-{{ ai_gen_id }}__card {
    min-width: 0;
    overflow: hidden;
    border-radius: {{ block.settings.card_radius }}px;
    background: {{ block.settings.card_background }};
    color: #121212;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
  }

  .ai-influencers-{{ ai_gen_id }}__media,
  .ai-influencers-{{ ai_gen_id }}__placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #f3f3f3;
  }

  .ai-influencers-{{ ai_gen_id }}__media {
    height: 100%;
    object-fit: cover;
  }

  .ai-influencers-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-influencers-{{ ai_gen_id }}__body {
    padding: 16px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-influencers-{{ ai_gen_id }}__name {
    margin: 0;
    color: #121212;
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .ai-influencers-{{ ai_gen_id }}__detail {
    margin: 8px 0 0;
    color: #333333;
    font-size: 0.95rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .ai-influencers-{{ ai_gen_id }}__link {
    display: inline-block;
    margin-top: 10px;
    color: #121212;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  .ai-influencers-{{ ai_gen_id }}__empty {
    grid-column: 1 / -1;
    margin: 0;
    padding: 24px;
    background: #f3f3f3;
    color: #333333;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-influencers-{{ ai_gen_id }} {
      padding: 24px 16px;
    }

    .ai-influencers-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr));
      gap: 14px;
    }

    .ai-influencers-{{ ai_gen_id }}__body {
      padding: 12px;
    }
  }
{% endstyle %}

<div class="ai-influencers-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-influencers-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
  {% endif %}

  <div class="ai-influencers-{{ ai_gen_id }}__grid">
    {% assign influencer_entries = shop.metaobjects.influencers.values %}
    {% assign influencer_count = 0 %}
    {% for influencer in influencer_entries %}
      {% assign active_field = influencer.active %}
      {% if active_field == blank or active_field.value != false %}
        {% assign influencer_count = influencer_count | plus: 1 %}
        {% assign influencer_name = influencer.title.value | default: influencer.name.value %}
        {% assign influencer_image = influencer.image.value | default: influencer.photo.value %}
        {% assign influencer_description = influencer.description.value | default: influencer.bio.value %}
        {% assign influencer_link = influencer.website.value | default: influencer.social_link.value %}
        <article class="ai-influencers-{{ ai_gen_id }}__card">
          {% if influencer_image != blank %}
            <img
              class="ai-influencers-{{ ai_gen_id }}__media"
              src="{{ influencer_image | image_url: width: 900 }}"
              alt="{{ influencer_image.alt | default: influencer_name | escape }}"
              loading="lazy"
              width="{{ influencer_image.width }}"
              height="{{ influencer_image.height }}"
            >
          {% else %}
            <div class="ai-influencers-{{ ai_gen_id }}__placeholder">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
          <div class="ai-influencers-{{ ai_gen_id }}__body">
            {% if influencer_name != blank %}
              <h3 class="ai-influencers-{{ ai_gen_id }}__name">{{ influencer_name | escape }}</h3>
            {% endif %}
            {% if block.settings.show_description and influencer_description != blank %}
              <div class="ai-influencers-{{ ai_gen_id }}__detail">{{ influencer_description | metafield_tag }}</div>
            {% endif %}
            {% if influencer_link != blank and block.settings.show_link %}
              <a class="ai-influencers-{{ ai_gen_id }}__link" href="{{ influencer_link | escape }}" target="_blank" rel="noopener noreferrer" aria-label="Visit {{ influencer_name | default: 'influencer' | escape }} online">{{ block.settings.link_label | escape }}</a>
            {% endif %}
          </div>
        </article>
      {% endif %}
    {% endfor %}
    {% if influencer_count == 0 and request.design_mode %}
      <p class="ai-influencers-{{ ai_gen_id }}__empty">Add entries to the Influencers metaobject definition to display them here.</p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Influencers list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Influencers"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Card text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description or bio",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_link",
      "label": "Show public link",
      "default": true
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Visit profile"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Influencers list"
    }
  ],
  "tag": null,
  "class": "influencers-list-block"
}
{% endschema %}