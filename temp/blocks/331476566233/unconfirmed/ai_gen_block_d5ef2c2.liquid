{% doc %}
  @prompt
    Create an Influencers collection-style grid for the checktest page (not a product collection). Automatically load all storefront-accessible entries of the Influencers metaobject type influencers, rather than requiring manually selected entries or copied text. Each card should display the entry's name field (key name) and description field (key description). Use a responsive grid consistent with the current theme. Include pagination if needed so the full list can be browsed. Changes to entries and newly added storefront-accessible entries should be reflected automatically. Keep this block on the checktest page template only, without altering other pages., you have added grid but i wanted collection so when i create one section then i can select that collection of influencers
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-influencers-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: #000000;
    font-family: Helvetica, Arial, sans-serif;
  }

  .ai-influencers-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .ai-influencers-{{ ai_gen_id }}__card {
    min-width: 0;
    padding: 24px;
    background: #fafaf9;
    border: 1px solid rgba(18, 18, 18, 0.12);
    border-radius: 4px;
  }

  .ai-influencers-{{ ai_gen_id }}__name {
    margin: 0 0 10px;
    color: #000000;
    font-size: 20px;
    line-height: 1.25;
    font-weight: 700;
  }

  .ai-influencers-{{ ai_gen_id }}__description {
    color: #121212;
    font-size: 16px;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .ai-influencers-{{ ai_gen_id }}__description p {
    margin: 0 0 0.75em;
  }

  .ai-influencers-{{ ai_gen_id }}__description p:last-child {
    margin-bottom: 0;
  }

  .ai-influencers-{{ ai_gen_id }}__empty {
    margin: 0;
    color: #333333;
    font-size: 16px;
    line-height: 1.5;
  }

  .ai-influencers-{{ ai_gen_id }}__pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-top: 24px;
    font-size: 15px;
  }

  .ai-influencers-{{ ai_gen_id }}__pagination a {
    color: #121212;
    text-underline-offset: 3px;
  }

  .ai-influencers-{{ ai_gen_id }}__pagination a:focus-visible {
    outline: 2px solid #121212;
    outline-offset: 4px;
  }

  .ai-influencers-{{ ai_gen_id }}__page-current {
    color: #121212;
  }

  @media screen and (max-width: 749px) {
    .ai-influencers-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .ai-influencers-{{ ai_gen_id }}__card {
      padding: 18px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-influencers-{{ ai_gen_id }}__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<div class="ai-influencers-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.influencer_collection != blank %}
    {% paginate block.settings.influencer_collection.values by 12 %}
      {% if paginate.items > 0 %}
        <div class="ai-influencers-{{ ai_gen_id }}__grid">
          {% for entry in block.settings.influencer_collection.values %}
            {% assign entry_name = entry.name.value %}
            {% assign entry_description = entry.description.value %}
            <article class="ai-influencers-{{ ai_gen_id }}__card">
              {% if entry_name != blank %}
                <h2 class="ai-influencers-{{ ai_gen_id }}__name">{{ entry_name | escape }}</h2>
              {% endif %}
              {% if entry_description != blank %}
                <div class="ai-influencers-{{ ai_gen_id }}__description">{{ entry_description | metafield_tag }}</div>
              {% endif %}
            </article>
          {% endfor %}
        </div>
        {% if paginate.pages > 1 %}
          <nav class="ai-influencers-{{ ai_gen_id }}__pagination" aria-label="Influencers pages">
            {% if paginate.previous %}
              <a href="{{ paginate.previous.url }}" aria-label="Previous page">Previous</a>
            {% endif %}
            <span class="ai-influencers-{{ ai_gen_id }}__page-current">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
            {% if paginate.next %}
              <a href="{{ paginate.next.url }}" aria-label="Next page">Next</a>
            {% endif %}
          </nav>
        {% endif %}
      {% else %}
        <p class="ai-influencers-{{ ai_gen_id }}__empty">This influencer collection has no entries yet.</p>
      {% endif %}
    {% endpaginate %}
  {% else %}
    <p class="ai-influencers-{{ ai_gen_id }}__empty">Select an Influencers collection in this block's settings.</p>
  {% endif %}
</div>

{% schema %}
{
  "name": "Influencers collection",
  "settings": [
    {
      "type": "metaobject",
      "id": "influencer_collection",
      "label": "Influencers collection",
      "metaobject_type": "influencers"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Influencers collection"
    }
  ],
  "tag": null,
  "class": "influencers-grid-block"
}
{% endschema %}