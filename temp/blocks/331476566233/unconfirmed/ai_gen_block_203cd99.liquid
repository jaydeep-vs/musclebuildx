{% doc %}
  @prompt
    A magazine-style editorial layout
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-inline: auto;
    padding: 32px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    font-family: {{ settings.type_body_font.family }}, sans-serif;
  }
  .ai-editorial-{{ ai_gen_id }} * { box-sizing: border-box; }
  .ai-editorial-{{ ai_gen_id }}__eyebrow { margin: 0 0 12px; color: {{ block.settings.accent_color }}; font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .ai-editorial-{{ ai_gen_id }}__heading { margin: 0; max-width: 900px; color: {{ block.settings.text_color }}; font-family: {{ settings.type_header_font.family }}, sans-serif; font-size: clamp(36px, 6vw, {{ block.settings.heading_size }}px); line-height: .98; letter-spacing: -.045em; }
  .ai-editorial-{{ ai_gen_id }}__deck { max-width: 660px; margin: 18px 0 28px; font-size: 17px; line-height: 1.6; }
  .ai-editorial-{{ ai_gen_id }}__grid { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(220px, .8fr); gap: 26px; align-items: stretch; }
  .ai-editorial-{{ ai_gen_id }}__image { display: block; width: 100%; height: 100%; min-height: 320px; object-fit: cover; }
  .ai-editorial-{{ ai_gen_id }}__placeholder { min-height: 320px; position: relative; display: grid; place-items: center; overflow: hidden; background: #e8e8e6; }
  .ai-editorial-{{ ai_gen_id }}__placeholder svg { width: 100%; height: 100%; min-height: 320px; color: #777; }
  .ai-editorial-{{ ai_gen_id }}__empty { position: absolute; bottom: 14px; left: 14px; right: 14px; padding: 9px 12px; background: #fff; color: #222; font-size: 13px; text-align: center; }
  .ai-editorial-{{ ai_gen_id }}__side { display: flex; flex-direction: column; justify-content: space-between; border-top: 3px solid {{ block.settings.accent_color }}; padding-top: 16px; }
  .ai-editorial-{{ ai_gen_id }}__side-title { margin: 0 0 12px; color: {{ block.settings.text_color }}; font-family: {{ settings.type_header_font.family }}, sans-serif; font-size: 25px; line-height: 1.08; }
  .ai-editorial-{{ ai_gen_id }}__body { font-size: 15px; line-height: 1.7; }
  .ai-editorial-{{ ai_gen_id }}__body p { margin: 0 0 14px; }
  .ai-editorial-{{ ai_gen_id }}__link { display: inline-flex; align-items: center; gap: 8px; width: fit-content; margin-top: 16px; padding: 11px 0; border-bottom: 1px solid currentColor; color: {{ block.settings.text_color }}; font-size: 13px; font-weight: 700; letter-spacing: .06em; text-decoration: none; text-transform: uppercase; }
  .ai-editorial-{{ ai_gen_id }}__link:focus-visible { outline: 2px solid {{ block.settings.accent_color }}; outline-offset: 4px; }
  .ai-editorial-{{ ai_gen_id }}__caption { margin: 9px 0 0; color: {{ block.settings.text_color }}; font-size: 12px; line-height: 1.5; opacity: .8; }
  @media screen and (max-width: 749px) {
    .ai-editorial-{{ ai_gen_id }} { padding: 22px 16px; width: 100%; }
    .ai-editorial-{{ ai_gen_id }}__grid { grid-template-columns: 1fr; gap: 20px; }
    .ai-editorial-{{ ai_gen_id }}__image, .ai-editorial-{{ ai_gen_id }}__placeholder { min-height: 230px; }
    .ai-editorial-{{ ai_gen_id }}__placeholder svg { min-height: 230px; }
  }
{% endstyle %}

<article class="ai-editorial-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.eyebrow != blank %}<p class="ai-editorial-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
  {% if block.settings.heading != blank %}<h2 class="ai-editorial-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
  {% if block.settings.deck != blank %}<p class="ai-editorial-{{ ai_gen_id }}__deck">{{ block.settings.deck | escape }}</p>{% endif %}
  <div class="ai-editorial-{{ ai_gen_id }}__grid">
    <div>
      {% if block.settings.image != blank %}
        <img class="ai-editorial-{{ ai_gen_id }}__image" src="{{ block.settings.image | image_url: width: 1800 }}" alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
      {% else %}
        <div class="ai-editorial-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}<div class="ai-editorial-{{ ai_gen_id }}__empty">Add an editorial image to complete this feature.</div></div>
      {% endif %}
      {% if block.settings.caption != blank %}<p class="ai-editorial-{{ ai_gen_id }}__caption">{{ block.settings.caption | escape }}</p>{% endif %}
    </div>
    <div class="ai-editorial-{{ ai_gen_id }}__side">
      <div>
        {% if block.settings.side_heading != blank %}<h3 class="ai-editorial-{{ ai_gen_id }}__side-title">{{ block.settings.side_heading | escape }}</h3>{% endif %}
        {% if block.settings.body != blank %}<div class="ai-editorial-{{ ai_gen_id }}__body">{{ block.settings.body }}</div>{% endif %}
      </div>
      {% if block.settings.link_label != blank and block.settings.link_url != blank %}<a class="ai-editorial-{{ ai_gen_id }}__link" href="{{ block.settings.link_url }}">{{ block.settings.link_label | escape }} <span aria-hidden="true">→</span></a>{% endif %}
    </div>
  </div>
</article>

{% schema %}
{
  "name": "Editorial layout",
  "settings": [
    { "type": "header", "content": "Editorial content" },
    { "type": "text", "id": "eyebrow", "label": "Category", "default": "The journal" },
    { "type": "text", "id": "heading", "label": "Main headline", "default": "A stronger story starts here" },
    { "type": "textarea", "id": "deck", "label": "Intro text", "default": "Thoughtful training, considered recovery, and the everyday rituals that help you keep moving forward." },
    { "type": "image_picker", "id": "image", "label": "Feature image" },
    { "type": "text", "id": "caption", "label": "Image caption", "default": "The details behind a more intentional routine." },
    { "type": "text", "id": "side_heading", "label": "Story heading", "default": "Built on the habits that last" },
    { "type": "richtext", "id": "body", "label": "Story text", "default": "<p>Progress is rarely one dramatic moment. It is the steady work, smart choices, and recovery that come together over time.</p><p>Explore ideas designed to support your next step, wherever you are in your training journey.</p>" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Explore the story" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "header", "content": "Layout and style" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "heading_size", "label": "Headline size", "min": 40, "max": 80, "step": 5, "unit": "px", "default": 60 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FAFAF9" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#121212" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#00766E" }
  ],
  "presets": [{ "name": "Editorial layout" }],
  "tag": null,
  "class": "editorial-layout-block"
}
{% endschema %}